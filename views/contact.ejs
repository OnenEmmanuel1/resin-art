<section class="py-5" style="margin-top: 80px;">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="display-4">Get In <span style="background: linear-gradient(45deg, var(--primary-color), var(--secondary-color)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Touch</span></h1>
            <div class="mx-auto mt-3 mb-4" style="width: 60px; height: 3px; background-color: var(--primary-color);"></div>
            <p class="lead text-muted-custom col-lg-8 mx-auto">Have a question, custom order request, or just want to say hello? We'd love to hear from you.</p>
        </div>

        <div class="row g-5">
            <!-- Contact Form -->
            <div class="col-lg-7">
                <div class="resin-card p-5">
                    <h3 class="mb-4">Send Us a Message</h3>
                    <form action="/contact" method="POST">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="name" class="form-label fw-semibold">Your Name</label>
                                <input type="text" class="form-control" id="name" name="name" placeholder="John Doe" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="email" class="form-label fw-semibold">Email Address</label>
                                <input type="email" class="form-control" id="email" name="email" placeholder="you@example.com" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="subject" class="form-label fw-semibold">Subject</label>
                            <input type="text" class="form-control" id="subject" name="subject" placeholder="Custom Order Inquiry" required>
                        </div>
                        <div class="mb-4">
                            <label for="message" class="form-label fw-semibold">Message</label>
                            <textarea class="form-control" id="message" name="message" rows="5" placeholder="Tell us about your project or question..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary-custom px-5 py-2">
                            <i class="fa-regular fa-paper-plane me-2"></i>Send Message
                        </button>
                    </form>
                </div>
            </div>

            <!-- Contact Info -->
            <div class="col-lg-5">
                <div class="resin-card p-5 mb-4">
                    <h3 class="mb-4">Contact Info</h3>
                    <div class="d-flex align-items-start mb-4">
                        <i class="fa-solid fa-location-dot fs-4 me-3" style="color: var(--primary-color);"></i>
                        <div>
                            <h6 class="fw-semibold mb-1">Address</h6>
                            <p class="text-muted-custom mb-0">123 Art District, Lagos, Nigeria</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-start mb-4">
                        <i class="fa-solid fa-phone fs-4 me-3" style="color: var(--primary-color);"></i>
                        <div>
                            <h6 class="fw-semibold mb-1">Phone</h6>
                            <p class="text-muted-custom mb-0">+234 800 RESIN ART</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-start mb-4">
                        <i class="fa-regular fa-envelope fs-4 me-3" style="color: var(--primary-color);"></i>
                        <div>
                            <h6 class="fw-semibold mb-1">Email</h6>
                            <p class="text-muted-custom mb-0">hello@resinart.com</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-start">
                        <i class="fa-brands fa-whatsapp fs-4 me-3 text-success"></i>
                        <div>
                            <h6 class="fw-semibold mb-1">WhatsApp</h6>
                            <p class="text-muted-custom mb-0">+234 800 000 0000</p>
                        </div>
                    </div>
                </div>

                <div class="resin-card p-5">
                    <h5 class="mb-3">Business Hours</h5>
                    <div class="d-flex justify-content-between mb-2"><span>Monday - Friday</span><span class="fw-semibold">9AM - 6PM</span></div>
                    <div class="d-flex justify-content-between mb-2"><span>Saturday</span><span class="fw-semibold">10AM - 4PM</span></div>
                    <div class="d-flex justify-content-between"><span>Sunday</span><span class="text-muted-custom">Closed</span></div>
                </div>
            </div>
        </div>
    </div>
</section>
