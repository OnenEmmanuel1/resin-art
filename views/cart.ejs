<section class="py-5" style="margin-top: 80px;">
    <div class="container">
        <div class="d-flex align-items-baseline mb-4">
            <h1 class="display-5 mb-0">Shopping Cart</h1>
            <% if (cartItems && cartItems.length > 0) { %>
                <% const totalQuantity = cartItems.reduce((acc, item) => acc + item.quantity, 0); %>
                <span class="fs-4 text-muted-custom ms-3">(<%= totalQuantity %> item<%= totalQuantity === 1 ? '' : 's' %>)</span>
            <% } %>
        </div>
        <% if (cartItems.length === 0) { %>
            <div class="text-center py-5">
                <i class="fa-solid fa-cart-shopping fs-1 text-muted-custom mb-3"></i>
                <h3>Your cart is empty</h3>
                <p class="text-muted-custom mb-4">Looks like you haven't added anything yet.</p>
                <a href="/shop" class="btn btn-primary-custom btn-lg px-5">Start Shopping</a>
            </div>
        <% } else { %>
            <div class="row">
                <div class="col-lg-8 mb-4">
                    <% cartItems.forEach(item => { %>
                        <div class="resin-card p-4 mb-3">
                            <div class="row align-items-center">
                                <div class="col-3 col-md-2">
                                    <% if (item.image_url) { %>
                                        <img src="<%= item.image_url %>" alt="<%= item.name %>" class="img-fluid rounded">
                                    <% } else { %>
                                        <div class="d-flex align-items-center justify-content-center rounded" style="background:linear-gradient(135deg,var(--primary-color),var(--secondary-color));height:80px"><i class="fa-solid fa-gem text-white"></i></div>
                                    <% } %>
                                </div>
                                <div class="col-9 col-md-4"><h6 class="mb-1"><%= item.name %></h6><small class="text-muted-custom">₦<%= Number(item.price).toLocaleString() %></small></div>
                                <div class="col-6 col-md-3 mt-2 mt-md-0">
                                    <form action="/cart/update" method="POST" class="d-flex align-items-center">
                                        <input type="hidden" name="product_id" value="<%= item.product_id %>">
                                        <div class="input-group input-group-sm" style="width:120px">
                                            <button type="submit" name="quantity" value="<%= item.quantity - 1 %>" class="btn btn-outline-secondary">-</button>
                                            <span class="form-control text-center"><%= item.quantity %></span>
                                            <button type="submit" name="quantity" value="<%= item.quantity + 1 %>" class="btn btn-outline-secondary">+</button>
                                        </div>
                                    </form>
                                </div>
                                <div class="col-4 col-md-2 text-end mt-2 mt-md-0"><strong style="color:var(--primary-color)">₦<%= (item.price * item.quantity).toLocaleString() %></strong></div>
                                <div class="col-2 col-md-1 text-end mt-2 mt-md-0">
                                    <form action="/cart/remove" method="POST"><input type="hidden" name="product_id" value="<%= item.product_id %>"><button type="submit" class="btn btn-sm text-danger"><i class="fa-solid fa-trash"></i></button></form>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
                <div class="col-lg-4">
                    <div class="resin-card p-4">
                        <h4 class="mb-4">Order Summary</h4>
                        <div class="d-flex justify-content-between mb-2"><span class="text-muted-custom">Subtotal</span><span>₦<%= Number(cartTotal).toLocaleString() %></span></div>
                        <div class="d-flex justify-content-between mb-2"><span class="text-muted-custom">VAT (7.5%)</span><span>₦<%= (cartTotal * 0.075).toLocaleString() %></span></div>
                        <div class="d-flex justify-content-between mb-3"><span class="text-muted-custom">Shipping</span><span><%= cartTotal > 50000 ? 'FREE' : '₦2,500' %></span></div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4"><strong class="fs-5">Total</strong><strong class="fs-5" style="color:var(--primary-color)">₦<%= (cartTotal + cartTotal*0.075 + (cartTotal>50000?0:2500)).toLocaleString() %></strong></div>
                        <a href="/cart/checkout" class="btn btn-primary-custom w-100 py-2"><i class="fa-solid fa-lock me-2"></i>Proceed to Checkout</a>
                        <a href="/shop" class="btn btn-outline-custom w-100 mt-2">Continue Shopping</a>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</section>
