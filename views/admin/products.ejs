<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Products (<%= products.length %>)</h2>
    <a href="/admin/products/add" class="btn btn-primary-custom"><i class="fa-solid fa-plus me-2"></i>Add Product</a>
</div>

<div class="stat-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Image</th><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                <% if (products.length === 0) { %>
                    <tr><td colspan="7" class="text-center py-4 text-muted-custom">No products found. <a href="/admin/products/add">Add one now.</a></td></tr>
                <% } %>
                <% products.forEach(p => { %>
                    <tr>
                        <td>
                            <% if (p.image_url) { %>
                                <img src="<%= p.image_url %>" class="rounded" style="width:50px;height:50px;object-fit:cover">
                            <% } else { %>
                                <div class="rounded d-flex align-items-center justify-content-center" style="width:50px;height:50px;background:linear-gradient(135deg,var(--primary-color),var(--secondary-color))"><i class="fa-solid fa-gem text-white small"></i></div>
                            <% } %>
                        </td>
                        <td><strong><%= p.name %></strong></td>
                        <td><%= p.category_name || '-' %></td>
                        <td>₦<%= Number(p.price).toLocaleString() %></td>
                        <td><span class="badge bg-<%= p.stock > 5 ? 'success' : p.stock > 0 ? 'warning' : 'danger' %>"><%= p.stock %></span></td>
                        <td><span class="badge bg-<%= p.status==='active'?'success':p.status==='draft'?'secondary':'danger' %>"><%= p.status %></span></td>
                        <td>
                            <a href="/admin/products/edit/<%= p.id %>" class="btn btn-sm btn-outline-custom me-1"><i class="fa-solid fa-edit"></i></a>
                            <form action="/admin/products/delete/<%= p.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete this product?')">
                                <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
