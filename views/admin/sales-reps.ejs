<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Sales Representatives</h2>
    <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addSalesRepModal"><i class="fa-solid fa-plus me-2"></i>Add Sales Rep</button>
</div>

<div class="stat-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>#</th><th>Name</th><th>Email</th><th>Phone</th><th>Joined</th><th>Action</th></tr></thead>
            <tbody>
                <% if (salesReps.length === 0) { %>
                    <tr><td colspan="6" class="text-center py-4 text-muted-custom">No sales reps yet.</td></tr>
                <% } %>
                <% salesReps.forEach((sr, i) => { %>
                    <tr>
                        <td><%= i + 1 %></td>
                        <td><strong><%= sr.first_name %> <%= sr.last_name %></strong></td>
                        <td><%= sr.email %></td>
                        <td><%= sr.phone || '-' %></td>
                        <td><%= new Date(sr.created_at).toLocaleDateString() %></td>
                        <td>
                            <form action="/admin/sales-reps/delete/<%= sr.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete this sales rep?')">
                                <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addSalesRepModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background:var(--card-bg)">
            <div class="modal-header">
                <h5 class="modal-title">Add Sales Representative</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/sales-reps/add" method="POST">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">First Name</label>
                            <input type="text" class="form-control" name="first_name" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Last Name</label>
                            <input type="text" class="form-control" name="last_name" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" name="email" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="tel" class="form-control" name="phone">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Temporary Password</label>
                        <input type="password" class="form-control" name="password" required minlength="6">
                        <small class="text-muted-custom">They can change this later in their profile.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary-custom">Add Sales Rep</button>
                </div>
            </form>
        </div>
    </div>
</div>
