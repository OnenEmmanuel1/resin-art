<h2 class="mb-4">Orders (<%= orders.length %>)</h2>

<div class="stat-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>#</th><th>Customer</th><th>Email</th><th>Amount</th><th>Status</th><th>Date</th><th>Action</th></tr></thead>
            <tbody>
                <% if (orders.length === 0) { %>
                    <tr><td colspan="7" class="text-center py-4 text-muted-custom">No orders yet.</td></tr>
                <% } %>
                <% orders.forEach(o => { %>
                    <tr>
                        <td><%= o.id %></td>
                        <td><%= o.first_name %> <%= o.last_name %></td>
                        <td class="text-muted-custom"><%= o.email %></td>
                        <td>₦<%= Number(o.total_amount).toLocaleString() %></td>
                        <td><span class="badge bg-<%= o.status==='delivered'?'success':o.status==='shipped'?'info':o.status==='paid'?'primary':o.status==='cancelled'?'danger':'warning' %>"><%= o.status %></span></td>
                        <td><%= new Date(o.created_at).toLocaleDateString() %></td>
                        <td><a href="/admin/orders/<%= o.id %>" class="btn btn-sm btn-outline-custom">View</a></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
