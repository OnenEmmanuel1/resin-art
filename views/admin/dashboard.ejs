<!-- Dashboard Stats -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted-custom small mb-1">Total Users</p>
                    <h3 class="mb-0"><%= usersCount %></h3>
                </div>
                <div class="stat-icon" style="background:rgba(139,92,246,0.1);color:var(--primary-color)"><i class="fa-solid fa-users"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted-custom small mb-1">Total Orders</p>
                    <h3 class="mb-0"><%= ordersCount %></h3>
                </div>
                <div class="stat-icon" style="background:rgba(236,72,153,0.1);color:var(--secondary-color)"><i class="fa-solid fa-receipt"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted-custom small mb-1">Pending Orders</p>
                    <h3 class="mb-0"><%= pendingOrders %></h3>
                </div>
                <div class="stat-icon" style="background:rgba(245,158,11,0.1);color:var(--accent-color)"><i class="fa-solid fa-clock"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted-custom small mb-1">Revenue</p>
                    <h3 class="mb-0">₦<%= Number(revenue).toLocaleString() %></h3>
                </div>
                <div class="stat-icon" style="background:rgba(34,197,94,0.1);color:#22c55e"><i class="fa-solid fa-naira-sign"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="stat-card">
            <h5 class="mb-3">Monthly Sales</h5>
            <canvas id="salesChart" height="100"></canvas>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="stat-card">
            <h5 class="mb-3">Quick Stats</h5>
            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted-custom">Products</span><strong><%= productsCount %></strong></div>
            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted-custom">Users</span><strong><%= usersCount %></strong></div>
            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted-custom">Pending</span><strong><%= pendingOrders %></strong></div>
            <div class="d-flex justify-content-between py-2"><span class="text-muted-custom">Revenue</span><strong style="color:var(--primary-color)">₦<%= Number(revenue).toLocaleString() %></strong></div>
        </div>
    </div>
</div>

<!-- Recent Orders -->
<div class="stat-card">
    <h5 class="mb-3">Recent Orders</h5>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>#</th><th>Customer</th><th>Amount</th><th>Status</th><th>Date</th><th>Action</th></tr></thead>
            <tbody>
                <% recentOrders.forEach(order => { %>
                    <tr>
                        <td><%= order.id %></td>
                        <td><%= order.first_name %> <%= order.last_name %></td>
                        <td>₦<%= Number(order.total_amount).toLocaleString() %></td>
                        <td><span class="badge bg-<%= order.status==='delivered'?'success':order.status==='shipped'?'info':order.status==='paid'?'primary':order.status==='cancelled'?'danger':'warning' %>"><%= order.status %></span></td>
                        <td><%= new Date(order.created_at).toLocaleDateString() %></td>
                        <td><a href="/admin/orders/<%= order.id %>" class="btn btn-sm btn-outline-custom">View</a></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const salesData = <%- JSON.stringify(monthlySales) %>;
    const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const labels = salesData.map(s => months[s.month - 1] + ' ' + s.year).reverse();
    const data = salesData.map(s => s.total).reverse();
    
    new Chart(document.getElementById('salesChart'), {
        type: 'bar',
        data: {
            labels: labels.length ? labels : ['No Data'],
            datasets: [{
                label: 'Revenue (₦)',
                data: data.length ? data : [0],
                backgroundColor: 'rgba(139, 92, 246, 0.5)',
                borderColor: 'rgba(139, 92, 246, 1)',
                borderWidth: 1, borderRadius: 8
            }]
        },
        options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });
});
</script>
