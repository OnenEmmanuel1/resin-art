<h2 class="mb-4">Users (<%= users.length %>)</h2>

<div class="stat-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>#</th><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Joined</th><th>Action</th></tr></thead>
            <tbody>
                <% users.forEach((u, i) => { %>
                    <tr>
                        <td><%= i + 1 %></td>
                        <td><strong><%= u.first_name %> <%= u.last_name %></strong></td>
                        <td><%= u.email %></td>
                        <td><%= u.phone || '-' %></td>
                        <td><span class="badge bg-<%= u.role==='admin'?'primary':'secondary' %>"><%= u.role %></span></td>
                        <td><%= new Date(u.created_at).toLocaleDateString() %></td>
                        <td>
                            <% if (u.role !== 'admin') { %>
                                <form action="/admin/users/delete/<%= u.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete this user?')">
                                    <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            <% } else { %>
                                <span class="text-muted-custom small">Protected</span>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
