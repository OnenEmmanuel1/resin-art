<section class="py-5" style="margin-top: 80px;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="/orders" class="btn btn-outline-custom"><i class="fa-solid fa-arrow-left me-2"></i>Back to Orders</a>
            <a href="/orders/track/<%= order.id %>" class="btn btn-primary-custom"><i class="fa-solid fa-truck-fast me-2"></i>Track Order</a>
        </div>
        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="resin-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="mb-0">Order #<%= order.id %></h2>
                        <span class="badge fs-6 
                            <%= order.status === 'delivered' ? 'bg-success' : 
                               order.status === 'shipped' ? 'bg-info' : 
                               order.status === 'paid' ? 'bg-primary' : 
                               order.status === 'cancelled' ? 'bg-danger' : 'bg-warning' %>">
                            <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                        </span>
                    </div>
                    <p class="text-muted-custom mb-1"><strong>Date:</strong> <%= new Date(order.created_at).toLocaleDateString('en-NG', { year:'numeric', month:'long', day:'numeric', hour:'2-digit', minute:'2-digit' }) %></p>
                    <p class="text-muted-custom mb-1"><strong>Shipping:</strong> <%= order.shipping_address %></p>
                    <% if (order.delivery_tracking_number) { %>
                        <p class="text-muted-custom mb-0"><strong>Tracking:</strong> <%= order.delivery_tracking_number %></p>
                    <% } %>
                    <hr>
                    <h5 class="mb-3">Items</h5>
                    <% items.forEach(item => { %>
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                            <div class="d-flex align-items-center">
                                <% if (item.image_url) { %>
                                    <img src="<%= item.image_url %>" class="rounded me-3" style="width:50px;height:50px;object-fit:cover">
                                <% } %>
                                <div><strong><%= item.name %></strong><br><small>Qty: <%= item.quantity %> × ₦<%= Number(item.price).toLocaleString() %></small></div>
                            </div>
                            <strong>₦<%= (item.price * item.quantity).toLocaleString() %></strong>
                        </div>
                    <% }) %>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="resin-card p-4">
                    <h4 class="mb-3">Payment Info</h4>
                    <% if (payment) { %>
                        <div class="d-flex justify-content-between mb-2"><span class="text-muted-custom">Reference</span><span class="small"><%= payment.reference %></span></div>
                        <div class="d-flex justify-content-between mb-2"><span class="text-muted-custom">Status</span><span class="badge bg-<%= payment.status === 'success' ? 'success' : 'warning' %>"><%= payment.status %></span></div>
                    <% } %>
                    <hr>
                    <div class="d-flex justify-content-between"><strong class="fs-5">Total</strong><strong class="fs-5" style="color:var(--primary-color)">₦<%= Number(order.total_amount).toLocaleString() %></strong></div>
                </div>
            </div>
        </div>
    </div>
</section>
