<section class="py-5" style="margin-top: 80px;">
    <div class="container">
        <h1 class="display-5 mb-4">My Orders</h1>
        <% if (orders.length === 0) { %>
            <div class="text-center py-5">
                <i class="fa-solid fa-box-open fs-1 text-muted-custom mb-3"></i>
                <h3>No orders yet</h3>
                <p class="text-muted-custom mb-4">You haven't placed any orders yet.</p>
                <a href="/shop" class="btn btn-primary-custom btn-lg px-5">Shop Now</a>
            </div>
        <% } else { %>
            <% orders.forEach(order => { %>
                <div class="resin-card p-4 mb-3">
                    <div class="row align-items-center">
                        <div class="col-md-2"><strong>Order #<%= order.id %></strong></div>
                        <div class="col-md-3"><small class="text-muted-custom"><%= new Date(order.created_at).toLocaleDateString('en-NG', { year:'numeric', month:'long', day:'numeric' }) %></small></div>
                        <div class="col-md-2">
                            <span class="badge 
                                <%= order.status === 'delivered' ? 'bg-success' : 
                                   order.status === 'shipped' ? 'bg-info' : 
                                   order.status === 'paid' ? 'bg-primary' : 
                                   order.status === 'cancelled' ? 'bg-danger' : 'bg-warning' %>">
                                <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                            </span>
                        </div>
                        <div class="col-md-3"><strong style="color:var(--primary-color)">₦<%= Number(order.total_amount).toLocaleString() %></strong></div>
                        <div class="col-md-2 text-end"><a href="/orders/<%= order.id %>" class="btn btn-outline-custom btn-sm">View Details</a></div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</section>
